{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vrchat-translator",
  "version": "0.1.0",
  "identifier": "com.vrccommunity.vrchat-translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vrchat-translator",
        "width": 520,
        "height": 770,
        "additionalBrowserArgs": "--disable-web-security"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/"
    }
  }
}