{
  "name": "vrchat-translator",
  "private": true,
  "version": "0.1.0",
  "author": "ased12138",
  "description": "A simple translator for Vrchat",
  "type": "module",
  "main": "./dist-electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:build": "tauri android build",
    "tauri-dev": "tauri dev",
    "tauri-build": "tauri build",
    "electron-dev:main": "node ./scripts/dev-electron.js",
    "electron-dev": "concurrently 'vite' 'node ./scripts/dev-electron.js'",
    "electron-build": "node ./scripts/release-electron.js",
    "electron-build-render": "tsc && vite build --outDir dist-electron/render"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1023.0",
    "@aws-sdk/lib-storage": "3.1023.0",
    "@aws-sdk/s3-request-presigner": "3.1023.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@ricky0123/vad-web": "^0.0.30",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.3",
    "mime": "^4.1.0",
    "proxy-agent": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.2",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "code-inspector-plugin": "^1.4.3",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tree-kill": "^1.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^3.3.0"
  }
}
