{
  "name": "vrchat-translator",
  "private": true,
  "version": "1.0.0",
  "author": "ased12138",
  "description": "A simple translator for Vrchat",
  "type": "module",
  "main": "./dist-electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check --write ./src && biome check --write ./src-electron",
    "electron-dev": "node ./scripts/dev-electron.js",
    "electron-build": "node ./scripts/release-electron.js",
    "electron-build-render": "tsc && vite build --outDir dist-electron/render"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@ricky0123/vad-web": "^0.0.30",
    "cropperjs": "^2.2.0",
    "date-fns": "^4.4.0",
    "decibri": "^5.7.0",
    "i18next": "^26.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.12",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "code-inspector-plugin": "^1.6.6",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tree-kill": "^1.2.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^3.3.0"
  }
}