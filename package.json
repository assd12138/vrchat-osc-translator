{
  "name": "vrchat-translator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist-electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:build": "tauri android build",
    "tauri-dev": "tauri dev",
    "electron-dev": "node ./scripts/dev-electron.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@ricky0123/vad-web": "^0.0.30",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.5.6",
    "@tauri-apps/plugin-opener": "^2",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.17",
    "qiniu-js": "^3.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.6",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1",
    "tree-kill": "^1.2.2",
    "vite-plugin-static-copy": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "code-inspector-plugin": "^1.4.3",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.4",
    "typescript": "~5.8.3",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.vrchat-translator.app",
    "productName": "VRChat Translator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
